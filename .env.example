MONGODB_URI=mongodb://127.0.0.1:27017/codewild?replicaSet=rs0
# Atlas alternative: mongodb+srv://<username>:<password>@<cluster-host>/codewild?retryWrites=true&w=majority
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:3000
# Persona login is intentionally limited to local simulation deployments.
DEMO_MODE=true
DEMO_ACCESS_CODE=
# Optional approved college scheduling notification provider. Must honour Idempotency-Key.
WEEK1_NOTIFICATION_WEBHOOK_URL=
WEEK1_NOTIFICATION_WEBHOOK_TOKEN=
# JSON map: {"cohort-id":[{"name":"Contact name","email":"contact@example.org","approval":"Institution approval reference"}]}
WEEK1_COLLEGE_CONTACTS_JSON={}
# Reports and evidence uploads use private MongoDB automatically when this is blank.
# Optional existing private Blob deployment: set a PRIVATE Vercel Blob store token.
BLOB_READ_WRITE_TOKEN=
# Protect /api/pilot/cron. Schedule externally at least once per minute in active hours.
CRON_SECRET=
# College tenancy. Adopt existing data before enabling; see docs/college-tenancy-operations.md.
TENANCY_ENABLED=false
MASTER_DB_NAME=jungle_platform
# Optional separate registry connection; otherwise MONGODB_URI is reused.
MASTER_MONGODB_URI=
# Optional cluster URI for new colleges; adopted College for test retains MONGODB_URI.
TENANT_MONGODB_URI=
COLLEGE_CONNECTION_LIMIT=50
# Optional wildcard domain, e.g. vow.example.com. Local colleges use <name>.localhost.
# Without a wildcard domain, hosted college URLs use /c/<college-url-name>.
COLLEGE_ROOT_DOMAIN=
# Automatic account recovery. These values are server-only.
CMS_EMAIL_FROM=accounts@example.com
CMS_PUBLIC_ORIGIN=https://your-project.vercel.app
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=accounts@example.com
SMTP_AUTH_MODE=oauth2
SMTP_TENANT_ID=
SMTP_CLIENT_ID=
SMTP_CLIENT_SECRET=
# Only for an explicitly approved password-based SMTP deployment:
SMTP_PASS=

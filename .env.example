MONGODB_URI=mongodb://127.0.0.1:27017/codewild?replicaSet=rs0
# Atlas alternative: mongodb+srv://<username>:<password>@<cluster-host>/codewild?retryWrites=true&w=majority
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:3000
# Persona login is intentionally limited to local simulation deployments.
DEMO_MODE=true
DEMO_ACCESS_CODE=
# Optional approved college scheduling notification provider. Must honour Idempotency-Key.
WEEK1_NOTIFICATION_WEBHOOK_URL=
WEEK1_NOTIFICATION_WEBHOOK_TOKEN=
# JSON map: {"cohort-id":[{"name":"Contact name","email":"contact@example.org","approval":"Institution approval reference"}]}
WEEK1_COLLEGE_CONTACTS_JSON={}

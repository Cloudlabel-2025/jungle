{
  "name": "voyage-of-wilderness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --use-system-ca scripts/dev.mjs",
    "dev:next": "next dev --webpack --hostname 127.0.0.1",
    "prepare": "node scripts/prepare-lab.mjs",
    "build": "npm run prepare && next build --webpack",
    "brand:icons": "node scripts/build-vow-icons.mjs",
    "start": "next start --hostname 127.0.0.1",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-db.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:day1": "node scripts/check-day-one.mjs",
    "test:week1": "node scripts/check-day-one.mjs --all",
    "test:partb": "node scripts/check-part-b.mjs",
    "test:tenants": "node scripts/check-day-one.mjs --all --test-file=college-tenancy.test.mjs",
    "test:tenants:http": "node scripts/check-college-http.mjs",
    "test:portals": "node scripts/check-day-one.mjs --all --test-file=college-routing.test.mjs",
    "test:portals:http": "node scripts/check-college-portals.mjs",
    "colleges": "node --use-system-ca --env-file-if-exists=.env.local scripts/colleges.mjs",
    "platform:bootstrap": "node --use-system-ca --env-file-if-exists=.env.local scripts/platform-admin.mjs",
    "test:platform": "node scripts/check-day-one.mjs --all --test-file=platform-dashboard.test.mjs",
    "test:platform:http": "node scripts/check-platform-http.mjs",
    "test:cms": "node scripts/check-day-one.mjs --all --test-file=cms-accounts.test.mjs",
    "test:management": "node scripts/check-day-one.mjs --all --test-file=college-management.test.mjs",
    "test:password-setup:http": "node scripts/check-initial-password.mjs",
    "pilot:staging": "node --use-system-ca scripts/pilot-staging.mjs",
    "pilot:process": "node --env-file-if-exists=.env.local scripts/process-pilot.mjs"
  },
  "dependencies": {
    "@babel/standalone": "^7.28.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@vercel/blob": "^2.8.2",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.6.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "^4.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.0"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}

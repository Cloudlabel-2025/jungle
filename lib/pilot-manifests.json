      "fieldContract": [
        {
          "field": "First name, last name",
          "presence": "Required",
          "validation": "Unicode letters, spaces, hyphen/apostrophe; reject digits/inappropriate symbols; do not reject legitimate international names."
        },
        {
          "field": "Date of birth",
          "presence": "Required",
          "validation": "Real calendar date, not later than current date."
        },
        {
          "field": "Email",
          "presence": "Required; unique",
          "validation": "Format validation and normalized duplicate check; reject duplicate across alumni."
        },
        {
          "field": "Mobile",
          "presence": "Required",
          "validation": "Valid country code + number, normalized format; validation rules supplied in configuration."
        },
        {
          "field": "Address line 1",
          "presence": "Required",
          "validation": "Non-blank, bounded length; line 2 optional."
        },
        {
          "field": "City, State",
          "presence": "Required",
          "validation": "Non-blank; bounded length."
        },
        {
          "field": "Country",
          "presence": "Required LOV",
          "validation": "Select from controlled list."
        },
        {
          "field": "Postal/PIN code",
          "presence": "Required",
          "validation": "Validate against selected country format (e.g. India six-digit PIN); do not assume globally one format."
        },
        {
          "field": "Course / Degree",
          "presence": "Required LOV",
          "validation": "Valid option from configured course list."
        },
        {
          "field": "Graduation year",
          "presence": "Required",
          "validation": "Valid four-digit, not in future."
        },
        {
          "field": "Student registration no.",
          "presence": "Optional; unique if given",
          "validation": "Reject duplicate nonempty normalized value."
        },
        {
          "field": "Employment status",
          "presence": "Required LOV",
          "validation": "Employed / Self-employed / Seeking work / Higher studies."
        },
        {
          "field": "Primary skill",
          "presence": "Required LOV",
          "validation": "e.g. Java/Python/React/Node.js/SQL/Testing/Cloud; controlled config."
        },
        {
          "field": "Current job title",
          "presence": "Conditional",
          "validation": "Mandatory when employed."
        },
        {
          "field": "Current organisation",
          "presence": "Conditional",
          "validation": "Mandatory when employed."
        },
        {
          "field": "LinkedIn URL",
          "presence": "Optional",
          "validation": "Valid URL when present."
        },
        {
          "field": "Alumni ID",
          "presence": "System-generated",
          "validation": "Unique immutable identifier; never editable by user."
        },
        {
          "field": "Created / modified timestamps",
          "presence": "System-generated",
          "validation": "Server-created; modified advances on real update."
        }
      ]
